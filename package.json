import test from 'node:test';
import assert from 'node:assert/strict';
import { parseDecklist } from '../js/utils.js';
import { attackLegality, canPayMana, validateDeck } from '../js/rules.js';
import { createInitialState } from '../js/state.js';
import { defenseAdvice, possibleMoves } from '../js/coach.js';

const commander = {
  name: 'Satoru Umezawa', typeLine: 'Legendary Creature — Human Ninja', oracleText: '',
  colorIdentity: ['U', 'B'], legalities: { commander: 'legal' }, manaCost: '{2}{U}{B}', manaValue: 4,
};
const island = {
  name: 'Island', typeLine: 'Basic Land — Island', oracleText: '', colorIdentity: [],
  legalities: { commander: 'legal' }, manaCost: '', manaValue: 0,
};

test('decklist parser accepts export-style lines', () => {
  const result = parseDecklist('1 Satoru Umezawa\n2x Island\n1 Sol Ring (CMM) 396');
  assert.equal(result.errors.length, 0);
  assert.equal(result.entries.length, 3);
  assert.equal(result.entries[2].name, 'Sol Ring');
});

test('mana payment checks colored and generic requirements', () => {
  assert.equal(canPayMana({ W: 0, U: 1, B: 1, R: 0, G: 0, C: 2 }, '{2}{U}{B}').ok, true);
  assert.equal(canPayMana({ W: 0, U: 1, B: 0, R: 0, G: 0, C: 3 }, '{2}{U}{B}').ok, false);
});

test('Commander validation allows repeated basic lands', () => {
  const entries = [{ name: 'Satoru Umezawa', count: 1 }, { name: 'Island', count: 99 }];
  const byName = { 'satoru umezawa': commander, island };
  const result = validateDeck(entries, byName, ['Satoru Umezawa']);
  assert.deepEqual(result.errors, []);
});

test('possible moves include a land and affordable commander', () => {
  const state = createInitialState();
  state.phaseIndex = 3;
  state.players.p1.mana = { W: 0, U: 1, B: 1, R: 0, G: 0, C: 2 };
  state.players.p1.zones.hand.push({ ...island, instanceId: 'land', owner: 'p1', controller: 'p1' });
  state.players.p1.zones.command.push({ ...commander, instanceId: 'cmd', owner: 'p1', controller: 'p1', commander: true });
  state.players.p1.commanderCastCount.cmd = 0;
  const labels = possibleMoves(state).map((move) => move.label);
  assert(labels.includes('Play Island'));
  assert(labels.includes('Cast Satoru Umezawa'));
});

test('summoning sick creature is not a legal attacker', () => {
  const state = createInitialState();
  state.phaseIndex = 4;
  const card = { ...commander, instanceId: 'cmd', controller: 'p1', tapped: false, summoningSick: true, keywords: [] };
  assert.equal(attackLegality(state, card).legal, false);
});

test('defense advisor produces a block assignment', () => {
  const state = createInitialState();
  state.players.p1.zones.battlefield.push({ ...commander, instanceId: 'a', controller: 'p1', power: '3', toughness: '4', attacking: true, tapped: true, keywords: [] });
  state.players.p2.zones.battlefield.push({ ...commander, instanceId: 'b', controller: 'p2', power: '4', toughness: '4', attacking: false, tapped: false, keywords: [] });
  const advice = defenseAdvice(state);
  assert.equal(advice.assignments.length, 1);
  assert.equal(advice.assignments[0].blocker, 'Satoru Umezawa');
});
